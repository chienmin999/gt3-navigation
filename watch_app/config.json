{
  "app": {
    "bundleName": "com.navgt3se.watchapp",
    "vendor": "NavGT3SE",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "apiVersion": {
      "compatible": 6,
      "target": 6,
      "releaseType": "Release"
    }
  },
  "deviceConfig": {
    "default": {}
  },
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "default",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page"
      }
    ],
    "js": [
      {
        "name": "default",
        "pages": [
          "pages/index/index",
          "pages/waiting/waiting",
          "pages/compass/compass"
        ],
        "window": {
          "designWidth": 466,
          "autoDesignWidth": false
        }
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "Vibrate on turn"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "Check connection"
      },
      {
        "name": "ohos.permission.INTERNET",
        "reason": "Receive P2P data"
      },
      {
        "name": "ohos.permission.USE_BLUETOOTH",
        "reason": "Bluetooth communication"
      }
    ]
  }
}
